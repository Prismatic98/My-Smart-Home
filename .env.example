# Vorlage für .env.local (die echte Datei ist per .gitignore ausgeschlossen).
# Nach Änderungen den Dev-Server neu starten – Vite liest env-Dateien nur beim Start.

# Adresse der Home-Assistant-Instanz, ohne abschließenden Slash.
# Im Dev-Server nötig, weil es hier keinen Reverse-Proxy gibt. In Produktion
# bleibt die Variable leer, dann läuft HA über die eigene Origin – siehe
# .env.prod.example.
VITE_HA_URL=http://smarthome:8123

# Basis-URL des eigenen Backends. Leer lassen – der Client nimmt dann /backend
# auf der eigenen Origin, und der Vite-Proxy leitet das im Dev auf
# http://127.0.0.1:3001 um (siehe vite.config.js).
VITE_BACKEND_URL=

# --- Nur zur Information: Variablen des Backends -----------------------------
# Diese Datei wird von Vite gelesen und landet im Frontend-Bundle. Die
# folgenden Werte gehören dem Server in server/ und werden dort aus der
# Umgebung gelesen, nicht von hier. Ohne Angabe gilt der Standard.
#
# Wurzelverzeichnis der Dateiablage, relativ zum Arbeitsverzeichnis des
# Servers. Standard: ./data/files (also server/data/files, gitignored).
# Abweichend starten:  FILES_ROOT=/pfad/zur/ablage npm run dev
# FILES_ROOT=./data/files

# Long-Lived Access Token: Home Assistant → Profil → Sicherheit → Ganz unten.
# Achtung: VITE_-Variablen landen im Client-Bundle und sind für jeden sichtbar,
# der die App aufrufen kann. Das ist hier vertretbar, weil die App nur privat
# über Tailscale erreichbar ist.
VITE_HA_TOKEN=
