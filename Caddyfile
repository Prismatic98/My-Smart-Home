# Caddy macht hier zwei Dinge gleichzeitig:
#   1. die gebaute PWA aus /srv ausliefern (mit SPA-Fallback)
#   2. Home Assistant unter /api/* durchreichen
#
# Dadurch laufen App und Home Assistant über dieselbe Origin:
# kein CORS, und hinter dem HTTPS von Tailscale auch kein Mixed Content.
#
# TLS/Zertifikate übernimmt Tailscale (`tailscale serve`), deshalb lauscht
# Caddy nur auf http:8080.

{
	admin off
	auto_https off

	servers {
		timeouts {
			# Ohne Zeitlimit für den Request-Body: ein 5-GB-Upload über eine
			# langsame Leitung darf beliebig lange dauern. Caddy hat hier
			# ohnehin keine Vorgabe – das steht nur explizit da, damit es
			# niemand später versehentlich "aufräumt".
			read_body 0
			write 0
		}
	}
}

:8080 {
	log

	encode zstd gzip

	root * /srv

	# Gehashte Build-Assets (index-a1b2c3.js …) ändern bei jeder Änderung
	# ihren Namen und dürfen darum beliebig lange im Browser liegen.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# App-Shell und Service Worker müssen dagegen immer revalidiert werden,
	# sonst bekommt eine installierte PWA nie ein Update zu sehen.
	@revalidate path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @revalidate Cache-Control "no-cache"

	# --- Home Assistant ----------------------------------------------------
	# Der Container läuft mit network_mode: host, Home Assistant hört auf
	# 127.0.0.1:8123. Das deckt REST (/api/states, /api/services/…) und den
	# WebSocket unter /api/websocket ab: reverse_proxy erkennt den
	# Upgrade-Header und reicht die Verbindung transparent und ohne Timeout
	# durch, es braucht also keine Sonderbehandlung für den Socket.
	handle /api/* {
		reverse_proxy 127.0.0.1:8123
	}

	# --- Eigenes Backend ---------------------------------------------------
	# Notizen-Sync (Fastify, ebenfalls network_mode: host). Das Präfix wird
	# abgeschnitten, /backend/notes/sync landet also als /notes/sync.
	#
	# Bewusst `handle` + `uri strip_prefix` statt `handle_path`: Caddy sortiert
	# Direktiven nach fester Reihenfolge, und `handle` läuft vor `handle_path`.
	# Der Catch-all-`handle`-Block unten würde /backend/* damit abfangen, bevor
	# ein handle_path zum Zug käme. Gleiche Direktive = Reihenfolge wie notiert.
	handle /backend/* {
		uri strip_prefix /backend

		# Obergrenze für einen Upload. Muss zu MAX_UPLOAD_BYTES im Backend
		# passen. Hinweis: der Multipart-Rahmen zählt mit, eine Datei ganz
		# knapp unter 5 GB kann also hier abprallen statt mit der schöneren
		# Meldung des Backends.
		request_body {
			max_size 5GB
		}

		reverse_proxy 127.0.0.1:3001 {
			# Große Uploads und Downloads dürfen nicht mittendrin gekappt
			# werden. 0 = kein Limit (ist auch der Standard, hier bewusst
			# ausgeschrieben).
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# --- PWA ---------------------------------------------------------------
	handle {
		# SPA-Fallback: existiert der Pfad nicht als Datei, wird index.html
		# ausgeliefert. Damit funktionieren Deeplinks wie /notizen auch beim
		# harten Neuladen – die Route löst dann der React-Router auf.
		try_files {path} /index.html
		file_server
	}
}