# Vorlage für .env.prod – Konfiguration des Produktions-Builds auf dem Pi.
#
#   cp .env.prod.example .env.prod
#
# Die echte .env.prod ist per .gitignore ausgeschlossen und enthält den Token.
# Die Werte werden beim `docker compose build` als Build-Args gesetzt und von
# Vite fest ins Bundle gebacken – nach einer Änderung neu bauen.

# Leer lassen! Dann spricht die App Home Assistant über die eigene Origin an,
# und der Caddy-Proxy reicht /api/* (inkl. /api/websocket) an 127.0.0.1:8123
# weiter. Das funktioniert unter jedem Hostnamen, unter dem die App erreichbar
# ist – über Tailscale-HTTPS genauso wie über http://smarthome:8080.
# Nur setzen, wenn Home Assistant ausnahmsweise direkt (ohne Proxy)
# angesprochen werden soll, z. B. VITE_HA_URL=http://smarthome:8123
VITE_HA_URL=

# Long-Lived Access Token: Home Assistant → Profil → Sicherheit → ganz unten.
# Achtung: landet im Client-Bundle und ist für jeden sichtbar, der die App
# aufrufen kann. Vertretbar, weil die App nur privat über Tailscale erreichbar
# ist.
VITE_HA_TOKEN=

# Basis-URL des eigenen Backends. Leer lassen: der Client nimmt dann /backend
# auf der eigenen Origin, und Caddy reicht das an den Server-Container weiter.
VITE_BACKEND_URL=

# Wohin die SQLite-Datei auf dem Pi geschrieben wird (Bind-Mount).
# Relativ zu dieser docker-compose-Datei. Das Verzeichnis muss dem eigenen
# Benutzer gehören (uid 1000) – `mkdir -p data` vor dem ersten Start reicht.
# Achtung: `git clean -xdf` im Repo würde ./data mitnehmen. Wer sichergehen
# will, legt es außerhalb ab, z. B. /home/dennis/docker/data/my-smart-home.
BACKEND_DATA_DIR=./data

# Wurzel der Dateiablage auf dem Host. Liegt standardmäßig im Verzeichnis
# darüber; für eine eigene Platte hier einfach einen anderen Pfad eintragen.
# Ebenfalls uid 1000 – siehe README, Abschnitt Dateiablage.
FILES_DATA_DIR=./data/files

# Der zugehörige Pfad INNERHALB des Containers. Steht fest in
# docker-compose.prod.yml (FILES_ROOT: /data/files) und muss zum Mount-Ziel
# passen – nur ändern, wenn beides gemeinsam geändert wird.
# FILES_ROOT=/data/files