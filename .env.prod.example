# Vorlage für .env.prod – Konfiguration des Produktions-Builds auf dem Pi.
#
#   cp .env.prod.example .env.prod
#
# Die echte .env.prod ist per .gitignore ausgeschlossen und enthält den Token.
# Die Werte werden beim `docker compose build` als Build-Args gesetzt und von
# Vite fest ins Bundle gebacken – nach einer Änderung neu bauen.

# Leer lassen! Dann spricht die App Home Assistant über die eigene Origin an,
# und der Caddy-Proxy reicht /api/* (inkl. /api/websocket) an 127.0.0.1:8123
# weiter. Das funktioniert unter jedem Hostnamen, unter dem die App erreichbar
# ist – über Tailscale-HTTPS genauso wie über http://smarthome:8080.
# Nur setzen, wenn Home Assistant ausnahmsweise direkt (ohne Proxy)
# angesprochen werden soll, z. B. VITE_HA_URL=http://smarthome:8123
VITE_HA_URL=

# Long-Lived Access Token: Home Assistant → Profil → Sicherheit → ganz unten.
# Achtung: landet im Client-Bundle und ist für jeden sichtbar, der die App
# aufrufen kann. Vertretbar, weil die App nur privat über Tailscale erreichbar
# ist.
VITE_HA_TOKEN=